# Copy to <data dir>/.env (by default ../data/.env, a sibling of this checkout; see `make where`)
# and fill in the real value. The real file is never committed.
#   cp .env.example ../data/.env && chmod 600 ../data/.env
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: where daily backups are mirrored off-machine. Default: iCloud Drive/FeedAppBackups.
# FEEDAPP_BACKUP_MIRROR=/path/to/mirror
# Optional: data dir override (db, .env, backups, pipeline.lock). Default: ../data, else ./data.
# FEEDAPP_DATA_DIR=/path/to/data
